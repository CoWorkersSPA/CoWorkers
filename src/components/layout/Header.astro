---
// src/components/layout/Header.astro
import Button from "@components/ui/Button.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";

const navLinks = [
    { label: "Servicios", href: "#servicios" },
    { label: "Mesón", href: "#meson" },
    { label: "Cómo trabajamos", href: "#como-trabajamos" },
    { label: "Equipo", href: "#equipo" },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full site-header">
    <div class="w-full flex items-center justify-between px-6 md:px-12 py-4">
        <a
            href="/"
            class="font-display text-base font-bold text-foreground no-underline hover:opacity-80 transition-opacity"
        >
            coworkers.cl
        </a>

        <nav class="hidden md:block" aria-label="Navegación principal">
            <ul class="flex items-center gap-8 list-none m-0 p-0">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-sm font-medium text-muted-foreground no-underline hover:text-foreground transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-3">
            <ThemeToggle />
            <Button href="#agendar" variant="solid" size="sm">
                Agendar 30 min
            </Button>
        </div>
    </div>

    <style>
        .site-header {
            background-color: transparent;
            border-bottom: 1px solid transparent;
            backdrop-filter: blur(0px);
            transition:
                background-color 0.3s ease,
                border-color 0.3s ease,
                backdrop-filter 0.3s ease;
        }

        .site-header.header--scrolled {
            background-color: color-mix(
                in oklab,
                var(--color-background) 85%,
                transparent
            );
            border-bottom-color: var(--color-border);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>

    <script>
        // Un centinela invisible justo debajo del borde superior de la página:
        // cuando sale del viewport, el header ya no está "arriba del todo".
        // IntersectionObserver en vez de un listener de scroll (no corre en cada frame).
        const header = document.getElementById("site-header");
        const sentinel = document.createElement("div");
        sentinel.setAttribute("aria-hidden", "true");
        sentinel.style.cssText =
            "position:absolute;top:20px;left:0;width:1px;height:1px;pointer-events:none;";
        document.body.prepend(sentinel);

        new IntersectionObserver(
            ([entry]) => {
                header?.classList.toggle("header--scrolled", !entry.isIntersecting);
            },
            { threshold: 0 },
        ).observe(sentinel);
    </script>
</header>
