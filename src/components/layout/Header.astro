---
// src/components/layout/Header.astro
import Button from "../ui/Button.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";

const navLinks = [
    { label: "Qué construimos", href: "#que-construimos" },
    { label: "Garantías", href: "#garantias" },
    { label: "Equipo", href: "#equipo" },
];
---

<header
    class="sticky top-0 z-50 w-full border-b border-border bg-background/85 backdrop-blur-md"
>
    <div class="w-full flex items-center justify-between px-6 md:px-12 py-4">
        <a
            href="/"
            class="font-display text-base font-bold text-foreground no-underline hover:opacity-80 transition-opacity"
        >
            coworkers.cl
        </a>

        <nav class="hidden md:block" aria-label="Navegación principal">
            <ul class="flex items-center gap-8 list-none m-0 p-0">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-sm font-medium text-muted-foreground no-underline hover:text-foreground transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-3">
            <ThemeToggle />
            <Button href="#agendar" variant="solid" size="sm">
                Agendar 30 min
            </Button>
        </div>
    </div>
</header>
