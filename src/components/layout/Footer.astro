---
// src/components/layout/Footer.astro
import Wordmark from "@components/ui/Wordmark.astro";

const navLinks = [
    { label: "Servicios", href: "#servicios" },
    { label: "Mesón", href: "#meson" },
    { label: "Cómo trabajamos", href: "#como-trabajamos" },
    { label: "Equipo", href: "#equipo" },
];
---

<footer class="footer">
    <div class="container">
        <div>
            <Wordmark height={24} />
            <p class="tag">Software que se entiende.</p>
        </div>
        <ul>
            {navLinks.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
            ))}
        </ul>
        <ul>
            <li>Coworkers SpA</li>
            <li>Concepción, Chile</li>
            <li><a href="mailto:hola@coworkers.cl">hola@coworkers.cl</a></li>
        </ul>
    </div>
</footer>

<style>
    .footer { border-top: 1px solid var(--divider); padding: 40px 0 48px; font-size: 14px; color: var(--n-500); }
    .footer .container { display: grid; grid-template-columns: 1fr auto auto; gap: 24px 56px; align-items: start; }
    .tag { margin-top: 12px; color: var(--n-400); }
    ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    a:hover { color: var(--text); }
    @media (max-width: 767px) { .footer .container { grid-template-columns: 1fr; } }
</style>
