---
// src/components/layout/Footer.astro
const navLinks = [
    { label: "Servicios", href: "#servicios" },
    { label: "Mesón", href: "#meson" },
    { label: "Cómo trabajamos", href: "#como-trabajamos" },
    { label: "Equipo", href: "#equipo" },
];
---

<footer class="w-full border-t border-border bg-background py-8 md:py-10">
    <div
        class="wrapper flex flex-col md:flex-row items-center justify-between gap-6"
    >
        <div
            class="flex flex-col sm:flex-row items-center gap-3 md:gap-6 text-center md:text-left"
        >
            <a
                href="/"
                class="font-display font-bold text-base text-foreground no-underline hover:opacity-80 transition-opacity"
            >
                coworkers.cl
            </a>
            <p class="text-xs md:text-sm text-foreground">Software que se entiende.</p>
            <span class="hidden sm:inline text-border">|</span>
            <p class="text-xs md:text-sm text-muted-foreground">
                © {new Date().getFullYear()} Coworkers SpA. Concepción, Chile.
            </p>
        </div>

        <nav aria-label="Navegación del pie de página">
            <ul class="flex flex-wrap justify-center gap-6 list-none m-0 p-0">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-xs md:text-sm font-medium text-muted-foreground no-underline hover:text-foreground transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</footer>
