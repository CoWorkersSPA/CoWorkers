---
// src/components/layout/Footer.astro
import Wordmark from "@components/ui/Wordmark.astro";

const navLinks = [
  { label: "La ley de datos", href: "/#nos-llaman-cuando" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Cómo trabajamos", href: "/#como-trabajamos" },
  { label: "Equipo", href: "/#equipo" },
];

const email = "hola@coworkers.cl";
const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${email}`;
interface Props {
  hide?: boolean;
}

const { hide = false } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <hr class="rule" />
  </div>
  <div class="container grid">
    <div>
      <Wordmark height={24} />
      <p class="tag">Software que se entiende.</p>
    </div>
    {!hide && (
      <ul>
        {navLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    )}
    <ul>
      <li>Coworkers SpA</li>
      <li>RUT 78.508.844-1</li>
      <li>Concepción, Chile</li>
      <li>
        <a href={gmailUrl} target="_blank">
          hola@coworkers.cl
        </a>
      </li>
    </ul>
    <ul>
      <li>
        <a href="/privacidad">Política de privacidad</a>
      </li>
      <li>
        <a href="/terminos">Términos de servicio</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 0 0 48px;
    font-size: 14px;
    color: var(--n-500);
  }
  .footer::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 60vw;
    height: 160px;
    pointer-events: none;
    z-index: -1;
    background: radial-gradient(
      60% 100% at 50% 100%,
      color-mix(in srgb, var(--section-ghost) 26%, transparent),
      transparent 70%
    );
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 24px 56px;
    align-items: start;
    padding-top: 40px;
  }
  .tag {
    margin-top: 12px;
    color: var(--n-400);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  a {
    transition: color 0.2s var(--ease);
  }
  a:hover {
    color: var(--a-300);
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 40px;
    }
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
