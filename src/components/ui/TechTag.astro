---
// src/components/ui/TechTag.astro
interface Props {
    label: string;
    class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<span class:list={["tech-tag", className]}>{label}</span>

<style>
    .tech-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.375rem 0.875rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-text-muted);
    }
</style>
