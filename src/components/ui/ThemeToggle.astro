---
// src/components/ui/ThemeToggle.astro
// Cambio de tema. El oscuro es el de marca y el predeterminado; el claro es la variante.
// El estado real vive en data-theme sobre <html> y se guarda en localStorage. Mientras el visitante
// no elija, sigue la preferencia del sistema (Layout.astro lo resuelve antes del primer pintado).
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a tema claro">
    <i class="ph ph-sun" aria-hidden="true"></i>
    <i class="ph ph-moon" aria-hidden="true"></i>
</button>

<style>
    /* Sin contorno: es una utilidad, no una acción de marca. El único control delineado de la barra
       es "Agendar 30 min", que es la conversión. Aquí la afordancia la da el ícono y el fondo al pasar. */
    .theme-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; flex: none;
        background: transparent;
        border: 0;
        border-radius: var(--radius);
        color: var(--n-500);
        font-size: 19px; line-height: 1; cursor: pointer;
        transition: color 0.25s var(--ease), background-color 0.25s var(--ease);
    }
    .theme-toggle:hover {
        color: var(--text);
        background: color-mix(in srgb, var(--n-500) 14%, transparent);
    }
    .theme-toggle:active { transform: translateY(1px); }
    /* Se muestra el ícono del tema al que se va, no el del actual. */
    .theme-toggle .ph { display: none; }
    :global(html:not([data-theme="light"])) .theme-toggle .ph-sun { display: inline; }
    :global(html[data-theme="light"]) .theme-toggle .ph-moon { display: inline; }
</style>

<script>
    const root = document.documentElement;
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const COLORS = { dark: "#161826", light: "#f2f3fa" };

    const apply = (theme: "dark" | "light") => {
        root.setAttribute("data-theme", theme);
        if (meta) meta.content = COLORS[theme];
        document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
            b.setAttribute("aria-label", theme === "light" ? "Cambiar a tema oscuro" : "Cambiar a tema claro");
        });
    };

    // El cambio nace del botón: el tema nuevo se descubre en un círculo que crece desde ahí, sobre
    // una instantánea del anterior. El contenido sigue a la vista todo el rato. Es feedback, no
    // decoración. Sin soporte (Firefox), con reduced-motion o sin origen de clic, es instantáneo.
    const WIPE_MS = 560;

    const swap = (theme: "dark" | "light", origin?: { x: number; y: number }) => {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !origin || !document.startViewTransition) { apply(theme); return; }

        const { x, y } = origin;
        // +2px: el radio exacto a la esquina deja una hebra sin cubrir al quitar el recorte.
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + 2;
        root.style.setProperty("--wipe-x", `${x}px`);
        root.style.setProperty("--wipe-y", `${y}px`);
        root.classList.add("theme-wipe");
        const vt = document.startViewTransition(() => apply(theme));

        vt.ready
            .then(() =>
                root.animate(
                    { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
                    {
                        duration: WIPE_MS,
                        easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                        fill: "forwards", // sin esto el recorte vuelve al valor CSS en el último fotograma
                        pseudoElement: "::view-transition-new(root)",
                    },
                ).finished,
            )
            // La transición se salta sola si el documento está oculto o si llega otra encima: el tema
            // igual queda aplicado, así que no hay nada que rescatar ni que reportar.
            .catch(() => {})
            .finally(() => {
                root.classList.remove("theme-wipe");
                root.style.removeProperty("--wipe-x");
                root.style.removeProperty("--wipe-y");
            });
    };

    apply(root.getAttribute("data-theme") === "light" ? "light" : "dark");

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
            const r = btn.getBoundingClientRect();
            swap(next, { x: r.left + r.width / 2, y: r.top + r.height / 2 });
            try { localStorage.setItem("cw-theme", next); } catch {}
        });
    });

    // Si el visitante no ha elegido, sigue los cambios del sistema en vivo. Sin clic no hay origen,
    // así que el navegador hace su fundido cruzado.
    matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        try { if (localStorage.getItem("cw-theme")) return; } catch {}
        swap(e.matches ? "light" : "dark");
    });
</script>
