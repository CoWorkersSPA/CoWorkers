---
// src/components/ui/NumberedItem.astro
interface Props {
    number: string;
    title: string;
    description: string;
    class?: string;
}

const { number, title, description, class: className = "" } = Astro.props;
---

<div class:list={["numbered-item", className]}>
    <div class="numbered-item__head">
        <span class="numbered-item__number">{number}</span>
        <h3 class="numbered-item__title">{title}</h3>
    </div>
    <p class="numbered-item__desc">{description}</p>
</div>

<style>
    .numbered-item + .numbered-item {
        margin-top: var(--space-lg);
    }

    .numbered-item__head {
        display: flex;
        align-items: baseline;
        gap: 0.625rem;
        margin-bottom: 0.5rem;
    }

    .numbered-item__number {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-muted-foreground);
    }

    .numbered-item__title {
        font-family: var(--font-display);
        font-size: var(--text-h3);
        font-weight: 600;
        color: var(--color-foreground);
    }

    .numbered-item__desc {
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--color-muted-foreground);
        max-width: 55ch;
    }
</style>
