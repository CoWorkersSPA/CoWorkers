---
// src/components/ui/SectionSplit.astro
interface Props {
    heading?: string;
    title?: string;
    id?: string;
    class?: string;
}

const { heading, title, id, class: className = "" } = Astro.props;
const sectionHeading = heading || title;
---

<section id={id} class={`py-16 md:py-24 ${className}`}>
    <div class="wrapper">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Columna Izquierda: Título -->
            <div class="lg:col-span-5">
                {
                    sectionHeading && (
                        <h2 class="font-display font-bold text-2xl md:text-3xl text-foreground">
                            {sectionHeading}
                        </h2>
                    )
                }
                <slot name="title" />
            </div>

            <!-- Columna Derecha: Contenido -->
            <div class="lg:col-span-7 space-y-6 lg:pl-4">
                <slot />
            </div>
        </div>
    </div>
</section>
