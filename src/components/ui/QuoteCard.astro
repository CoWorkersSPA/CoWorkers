---
// src/components/ui/QuoteCard.astro
interface Props {
    quote: string;
    class?: string;
}

const { quote, class: className = "" } = Astro.props;
---

<div
    class={`pl-4 border-l border-foreground/20 text-foreground/90 font-normal text-base md:text-lg leading-snug ${className}`}
>
    “{quote}”
</div>
