---
// src/components/ui/Button.astro
// Botones de contorno, nunca relleno (Nocturne): "primary" con borde en acento, "ghost" en neutro.
interface Props {
    href?: string;
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "ghost";
    size?: "sm" | "md";
    target?: string;
    rel?: string;
    class?: string;
    /** Ícono Phosphor al final, p. ej. "ph-arrow-right". La flecha se dibuja como SVG en línea
     *  (el mismo trazo de Phosphor regular) para no depender de la fuente de íconos. */
    icon?: string;
}

const {
    href,
    type = "button",
    variant = "primary",
    size = "md",
    target,
    rel,
    class: className = "",
    icon,
} = Astro.props;

const classes = ["btn", `btn-${variant}`, `btn-${size}`, className].join(" ");
const isArrow = icon === "ph-arrow-right";
---

{/* Flecha: SVG de Phosphor (arrow-right, regular), en línea. */}


{
    href ? (
        <a href={href} target={target} rel={rel} class={classes}>
            <slot />
            {icon && (isArrow
                ? <svg class="btn-arrow" viewBox="0 0 256 256" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>
                : <i class={`ph ${icon}`} aria-hidden="true" />)}
        </a>
    ) : (
        <button type={type} class={classes}>
            <slot />
            {icon && (isArrow
                ? <svg class="btn-arrow" viewBox="0 0 256 256" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>
                : <i class={`ph ${icon}`} aria-hidden="true" />)}
        </button>
    )
}

<style is:global>
    .btn {
        position: relative; overflow: hidden;
        display: inline-flex; align-items: center; gap: 10px;
        min-height: 48px; padding: 0 22px;
        border-radius: var(--radius);
        border: 1px solid var(--accent);
        background: transparent;
        color: var(--a-300);
        font: 500 15px/1 var(--font);
        white-space: nowrap;
        cursor: pointer;
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
        transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.2s var(--ease), color 0.3s var(--ease), box-shadow 0.4s var(--ease);
    }
    .btn::before {
        /* brillo que barre el botón al pasar */
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(110deg, transparent 30%, color-mix(in srgb, var(--a-100) 16%, transparent) 50%, transparent 70%);
        transform: translateX(-120%);
    }
    .btn:hover {
        background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--a-100);
        border-color: var(--a-300);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent), 0 10px 30px -10px color-mix(in srgb, var(--accent) 60%, transparent);
    }
    .btn:active { transform: translateY(1px) scale(0.985); background: color-mix(in srgb, var(--accent) 24%, transparent); }
    .btn .ph { font-size: 18px; }
    .btn .btn-arrow { flex: none; transition: transform 0.3s var(--ease); }
    .btn:hover .btn-arrow { transform: translateX(4px); }
    .btn-ghost { border-color: var(--n-700); color: var(--n-300); }
    .btn-ghost:hover {
        border-color: var(--n-500); background: color-mix(in srgb, var(--n-500) 10%, transparent); color: var(--text);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--n-500) 8%, transparent), 0 10px 30px -12px var(--shadow-tint);
    }
    .btn-sm { min-height: 40px; padding: 0 16px; font-size: 14px; }
    @media (prefers-reduced-motion: no-preference) {
        .btn:hover::before { animation: btn-shine 0.9s var(--ease) forwards; }
        @keyframes btn-shine { to { transform: translateX(120%); } }
    }
</style>
