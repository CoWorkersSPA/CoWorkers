---
// src/components/sections/Guarantees.astro
// Los cuatro pilares del marco de mensajes (docs/MENSAJES.md, nivel 3), escritos desde lo que
// recibe el cliente. El cuarto pilar ("Nadie entrega sin revisión" en la estrategia) se presenta
// por su consecuencia para el cliente: hay alguien con nombre que responde.
const guarantees = [
    {
        icon: "ph-key",
        title: "Lo tuyo es tuyo",
        description:
            "El sistema, tus datos y el código quedan en tus manos. Puedes tenerlo en tu local sin pagar mensualidad, o dejarlo con nosotros para que nunca se apague. Y si un día prefieres a otro proveedor, te vas con todo.",
    },
    {
        icon: "ph-hand-tap",
        title: "Se entiende a la primera",
        description:
            "Lo instalamos en persona en tu mostrador y se usa con el dedo, como el teléfono. Sin manual, sin capacitación, sin implementador: tu equipo lo usa desde el primer día.",
    },
    {
        icon: "ph-stack",
        title: "Empiezas por lo que necesitas",
        description:
            "Pagas por resolver un problema, no por un sistema entero. Pero debajo ya tienes ventas, compras, inventario y contabilidad listos para cuando crezcas, sin migrar nada.",
    },
    {
        icon: "ph-identification-badge",
        title: "Respondemos con nombre y apellido",
        description:
            "Detrás de tu proyecto hay cinco ingenieros de Concepción, no una mesa de ayuda. Si algo falla, la persona que te contesta es la misma que responde por el trabajo.",
    },
];
---

<section class="section guarantees-section" id="garantias">
    <span class="glow" aria-hidden="true"></span>
    <div class="container guarantees">
        <div class="reveal intro">
            <h2 class="section-title">Esto va incluido, siempre.</h2>
            <p class="lede">Cuatro compromisos que van en cada proyecto, sea grande o chico.</p>
        </div>
        <div class="g-grid">
            {guarantees.map((g, i) => (
                <div class="g reveal" data-delay={i}>
                    <span class="icon-tile" aria-hidden="true"><i class={`ph ${g.icon}`}></i></span>
                    <h3>{g.title}</h3>
                    <p>{g.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .guarantees-section { overflow: hidden; }
    .glow {
        position: absolute; left: -12%; top: 20%; width: 44vw; height: 44vw; max-width: 680px; max-height: 680px;
        border-radius: 50%; pointer-events: none; z-index: -1;
        background: radial-gradient(closest-side,
            color-mix(in srgb, var(--coral) 12%, transparent) 0%,
            color-mix(in srgb, var(--coral) 7%, transparent) 40%,
            color-mix(in srgb, var(--coral) 2%, transparent) 68%,
            transparent 100%);
    }
    .guarantees { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; }
    .intro { position: sticky; top: calc(var(--nav-h) + 40px); align-self: start; }
    h2 { max-width: 14ch; }
    .lede { color: var(--n-400); margin-top: 18px; max-width: 40ch; }
    .g-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* Cada compromiso es una superficie sutil: degradado del fondo hacia nada, borde superior que se enciende. */
    .g {
        position: relative; padding: 28px 24px 30px;
        border-radius: var(--radius-lg);
        background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 70%, transparent), color-mix(in srgb, var(--surface) 15%, transparent));
        box-shadow: inset 0 1px 0 color-mix(in srgb, var(--a-100) 7%, transparent), 0 20px 40px -30px var(--shadow-tint);
        transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), background 0.5s var(--ease);
    }
    .g::before {
        content: ""; position: absolute; top: 0; left: 24px; right: 24px; height: 1px;
        background: linear-gradient(90deg, transparent, var(--accent), transparent);
        opacity: 0; transition: opacity 0.5s var(--ease);
    }
    .g::after {
        content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
        background: radial-gradient(70% 60% at 50% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
        opacity: 0; transition: opacity 0.5s var(--ease);
    }
    .g:hover { transform: translateY(-4px); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--a-100) 10%, transparent), 0 28px 50px -30px var(--shadow-tint), 0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent); }
    .g:hover::before, .g:hover::after { opacity: 1; }
    .g:hover .icon-tile { transform: translateY(-2px); color: var(--a-200); box-shadow: var(--shadow-glow); }
    .g:nth-child(2), .g:nth-child(4) { margin-top: 28px; } /* rejilla desfasada: rompe el 2x2 perfecto */
    .g h3 { font-size: 19px; margin: 18px 0 8px; }
    .g p { color: var(--n-400); font-size: 16px; position: relative; }
    @media (max-width: 1023px) { .guarantees { grid-template-columns: 1fr; gap: 32px; } .intro { position: static; } }
    @media (max-width: 639px) {
        .g-grid { grid-template-columns: 1fr; gap: 14px; }
        .g:nth-child(2), .g:nth-child(4) { margin-top: 0; }
    }
</style>
