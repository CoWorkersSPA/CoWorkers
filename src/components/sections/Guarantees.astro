---
// src/components/sections/Guarantees.astro
import SectionSplit from "@components/ui/SectionSplit.astro";
import FeatureCard from "@components/ui/FeatureCard.astro";

// Los cuatro pilares del marco de mensajes (docs/MENSAJES.md, nivel 3).
const guarantees = [
    {
        title: "Lo tuyo es tuyo",
        description:
            "Sistema, datos y código en tus manos. Puedes tenerlo en tu local sin mensualidad, o con nosotros para que nunca se apague. Si un día prefieres a otro, te vas con todo.",
    },
    {
        title: "Se entiende a la primera",
        description:
            "Sin manual, sin capacitación, sin implementador. Con el dedo, en una pantalla en tu mostrador, instalado en persona. Si necesita teclado, no es nuestro.",
    },
    {
        title: "Empiezas por lo que necesitas",
        description:
            "Compras la solución a un problema. Debajo trabaja un sistema completo, tuyo, con ventas, compras, inventario y contabilidad para cuando crezcas. Sin migrar nada.",
    },
    {
        title: "Nadie entrega sin revisión",
        description:
            "Ninguna tarea entra al proyecto sin pasar por los socios: cinco ingenieros con especialidades distintas mirando lo mismo desde cinco lados.",
    },
];
---

<section class="guarantees section fade-on-scroll bg-muted border-t border-border" id="garantias">
    <div class="wrapper">
        <SectionSplit heading="Lo que puedes exigirnos">
            <Fragment slot="title">
                <p class="mt-4 text-muted-foreground text-sm md:text-base leading-relaxed max-w-xs">
                    Cuatro compromisos. Si alguno deja de cumplirse, dejamos de ser Coworkers.cl.
                </p>
            </Fragment>
            <div class="guarantees__grid">
                {
                    guarantees.map((g) => (
                        <FeatureCard
                            title={g.title}
                            description={g.description}
                        />
                    ))
                }
            </div>
        </SectionSplit>
    </div>
</section>

<style>
    .guarantees__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-lg) var(--space-xl);
    }
    /* La grilla ya separa las tarjetas; el margen propio de FeatureCard no aplica aquí */
    .guarantees__grid > :global(.feature-card) {
        margin-top: 0;
    }

    @media (max-width: 700px) {
        .guarantees__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
