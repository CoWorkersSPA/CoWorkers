---
// src/components/sections/Guarantees.astro
// Los cuatro pilares del marco de mensajes (docs/MENSAJES.md, nivel 3).
const guarantees = [
    {
        icon: "ph-key",
        title: "Lo tuyo es tuyo",
        description:
            "Sistema, datos y código en tus manos. Puedes tenerlo en tu local sin mensualidad, o con nosotros para que nunca se apague. Si un día prefieres a otro, te vas con todo.",
    },
    {
        icon: "ph-hand-tap",
        title: "Se entiende a la primera",
        description:
            "Sin manual, sin capacitación, sin implementador. Con el dedo, en una pantalla en tu mostrador, instalado en persona. Si necesita teclado, no es nuestro.",
    },
    {
        icon: "ph-stack",
        title: "Empiezas por lo que necesitas",
        description:
            "Compras la solución a un problema. Debajo trabaja un sistema completo, tuyo, con ventas, compras, inventario y contabilidad para cuando crezcas. Sin migrar nada.",
    },
    {
        icon: "ph-eye",
        title: "Nadie entrega sin revisión",
        description:
            "Ninguna tarea entra al proyecto sin pasar por los socios: cinco ingenieros con especialidades distintas mirando lo mismo desde cinco lados.",
    },
];
---

<section class="section" id="garantias">
    <div class="container guarantees">
        <div class="reveal">
            <h2 class="section-title">Lo que puedes exigirnos.</h2>
            <p class="lede">Cuatro compromisos. Si alguno deja de cumplirse, dejamos de ser Coworkers.cl.</p>
        </div>
        <div class="g-grid">
            {guarantees.map((g, i) => (
                <div class="g reveal" data-delay={i}>
                    <i class={`ph ${g.icon}`} aria-hidden="true"></i>
                    <h3>{g.title}</h3>
                    <p>{g.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .guarantees { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; }
    h2 { max-width: 14ch; }
    .lede { color: var(--n-400); margin-top: 18px; max-width: 40ch; }
    .g-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; }
    .g { padding: 28px 0; border-top: 1px solid var(--divider); }
    .g .ph { font-size: 26px; color: var(--a-400); }
    .g h3 { font-size: 19px; margin: 14px 0 8px; }
    .g p { color: var(--n-400); font-size: 16px; }
    @media (max-width: 1023px) { .guarantees { grid-template-columns: 1fr; gap: 24px; } }
    @media (max-width: 639px) { .g-grid { grid-template-columns: 1fr; } }
</style>
