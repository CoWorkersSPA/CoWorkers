---
// src/components/sections/FinalCta.astro
// El cierre es el único lugar donde el lector busca precio y canal. No hay tarifa publicada
// todavía, así que va la prueba de precio que sí es verificable hoy (sin licencia por usuario,
// banco de pruebas nivel 4). El correo es el canal que existe; WhatsApp aparece solo si hay
// número en src/config.ts.
import ContactForm from "@components/ui/ContactForm.astro";
import { EMAIL, waLink } from "../../config";

const AGENDA_WA = waLink(
  "Hola, quiero agendar los 30 minutos para ver cómo trabajamos hoy.",
);
---

<section class="close" id="agendar">
  <div class="close-bg" aria-hidden="true">
    <span class="orb"></span>
    <span class="ring"></span>
  </div>
  <div class="container">
    <h2 class="reveal">
      Cuéntanos cómo <span class="text-glow">trabajas hoy.</span>
    </h2>
    <p class="reveal" data-delay="1">
      Treinta minutos en tu local, sin costo. Te decimos qué conviene resolver
      primero y sales con el alcance y el plazo por escrito, contrates o no.
    </p>
    <div class="reveal" data-delay="2">
      <ContactForm />
    </div>
    <p class="alt reveal" data-delay="3">
      {AGENDA_WA && (
        <>
          <a href={AGENDA_WA}>WhatsApp</a>
          {" · "}
        </>
      )}
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      {" · Concepción y alrededores"}
    </p>
    <p class="proof reveal" data-delay="4">
      Una sola mensualidad por cliente, sin licencia por usuario: cuesta lo
      mismo con cinco personas que con cincuenta.
    </p>
  </div>
</section>

<style>
  /* Único corte duro de la página, a propósito: el cierre no continúa el scroll, lo detiene.
     Por eso la línea va a sangre completa y no se desvanece en los extremos como las demás. */
  .close {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 120px 128px;
  }
  .close .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cf {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }
  .close::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    background: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .close-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .orb {
    /* queda dentro de la sección: si tocara el borde superior, el recorte se vería como una línea */
    position: absolute;
    left: 28%;
    top: 62%;
    width: 44vw;
    height: 30vw;
    max-width: 720px;
    max-height: 480px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--coral) 20%, transparent) 0%,
      color-mix(in srgb, var(--section-ghost) 40%, transparent) 55%,
      color-mix(in srgb, var(--section-ghost) 16%, transparent) 78%,
      transparent 100%
    );
  }
  .ring {
    /* anillo fino, descentrado a la derecha: profundidad sin ser un relleno */
    /* La altura se limita a la sección: si el anillo se saliera, overflow lo cortaría y el trazo
               quedaría partido en seco justo en la unión. */
    position: absolute;
    right: -14vw;
    top: 0;
    width: 52vw;
    height: min(52vw, 100%);
    max-width: 780px;
    max-height: 780px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--coral) 22%, transparent);
    -webkit-mask-image: linear-gradient(200deg, #000 30%, transparent 75%);
    mask-image: linear-gradient(200deg, #000 30%, transparent 75%);
  }
  .ring::before {
    content: "";
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--coral) 12%, transparent);
  }
  h2 {
    font-size: clamp(34px, 4.8vw, 60px);
    letter-spacing: -0.035em;
    line-height: 1.06;
    max-width: 20ch;
  }
  p {
    margin-top: 24px;
    max-width: 48ch;
    color: var(--n-400);
    font-size: 18px;
  }
  p.alt {
    margin-top: 26px;
    font-size: 15px;
    color: var(--n-400);
  }
  p.alt a {
    color: var(--a-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  p.alt a:hover {
    color: var(--a-200);
  }
  p.proof {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--divider);
    max-width: 44ch;
    font-size: 15px;
  }
  @media (max-width: 767px) {
    .close {
      padding-block: 80px 88px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb {
      animation: cta-orb 16s ease-in-out infinite alternate;
    }
    @keyframes cta-orb {
      from {
        transform: translate(-50%, -50%) scale(1);
      }
      to {
        transform: translate(-42%, -46%) scale(1.12);
      }
    }
  }
</style>
