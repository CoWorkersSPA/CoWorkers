---
// src/components/sections/FinalCta.astro
import SectionSplit from "../ui/SectionSplit.astro";
import Button from "../ui/Button.astro";
---

<SectionSplit
    id="agendar"
    class="section fade-on-scroll bg-muted border-t border-border"
>
    <Fragment slot="title">
        <h2
            class="font-display font-bold text-2xl md:text-3xl lg:text-4xl text-foreground leading-tight"
        >
            Cuéntanos cómo funciona hoy tu operación.
        </h2>
    </Fragment>

    <div class="space-y-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
            <div>
                <span class="block text-muted-foreground mb-1">Ubicación</span>
                <p class="font-medium text-foreground">Concepción, Chile</p>
            </div>
            <div>
                <span class="block text-muted-foreground mb-1">Contacto</span>
                <a
                    href="https://mail.google.com/mail/?view=cm&fs=1&to=hola@coworkers.cl&su=Consulta%20Agendamiento%2030%20min"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-foreground hover:underline"
                >
                    hola@coworkers.cl
                </a>
            </div>
        </div>

        <p class="text-muted-foreground text-sm md:text-base leading-relaxed">
            Treinta minutos, sin costo. Sales con el problema traducido a
            entregables y un plazo. Contrates o no.
        </p>

        <div>
            <Button
                href="https://mail.google.com/mail/?view=cm&fs=1&to=hola@coworkers.cl&su=Consulta%20Agendamiento%2030%20min"
                target="_blank"
                rel="noopener noreferrer"
                variant="solid"
                size="md"
            >
                Agendar 30 minutos
            </Button>
        </div>
    </div>
</SectionSplit>
