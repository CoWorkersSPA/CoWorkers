---
// src/components/sections/FinalCta.astro
import Button from "@components/ui/Button.astro";
---

<section class="close" id="agendar">
    <div class="container">
        <h2 class="reveal">Cuéntanos cómo funciona hoy tu operación.</h2>
        <p class="reveal" data-delay="1">
            Treinta minutos en tu local, sin costo. Sales con el alcance escrito y un plazo, contrates o no.
        </p>
        <Button
            href="mailto:hola@coworkers.cl?subject=Agendar%2030%20min"
            class="reveal"
            icon="ph-arrow-right">Agendar 30 min</Button
        >
    </div>
</section>

<style>
    .close { padding-block: 112px; }
    h2 { font-size: clamp(32px, 4.4vw, 54px); letter-spacing: -0.03em; line-height: 1.08; max-width: 22ch; }
    p { margin-top: 22px; max-width: 48ch; color: var(--n-400); font-size: 18px; }
    .close :global(.btn) { margin-top: 34px; }
</style>
