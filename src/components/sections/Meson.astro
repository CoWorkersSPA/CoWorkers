---
// src/components/sections/Meson.astro
// La segunda puerta: Mesón, de Coworkers.cl, para la pyme que atiende en el mostrador.
// Solo lo que la investigación de mercado deja en "vender ahora" (Datos, Cobros) y
// "segundo" (cotizaciones). Caja no se promete.
import Button from "@components/ui/Button.astro";

// TODO: cuando exista la página de Mesón (meson.coworkers.cl o /meson), apuntar ahí.
const MESON_HREF = "/meson";
---

<section
    id="meson"
    class="section fade-on-scroll bg-muted border-t border-border py-16 md:py-24"
>
    <div class="wrapper">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-center">
            <div class="lg:col-span-6 space-y-6">
                <p class="text-sm font-medium text-muted-foreground">
                    Mesón, de Coworkers.cl
                </p>
                <h2
                    class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-foreground tracking-tight leading-[1.1]"
                >
                    Tu negocio, <em class="not-italic text-primary">a la mano.</em>
                </h2>
                <p class="text-muted-foreground text-base md:text-lg leading-relaxed max-w-md">
                    Una tablet en tu mostrador que te deja ordenado para la ley
                    de datos, cobra a tiempo y cotiza sin llamar al proveedor.
                    Se usa con el dedo. Sin manual.
                </p>
                <div class="pt-2">
                    <Button href={MESON_HREF} variant="solid">Conocer Mesón</Button>
                </div>
            </div>

            <div class="lg:col-span-6">
                <!-- TODO: foto real de la tablet en un mostrador de Concepción, manos de trabajo, 4:3 -->
                <div
                    class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-border bg-background"
                >
                    <img
                        src="/meson-mostrador.jpg"
                        alt="Una tablet sobre el mostrador de una ferretería"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        onerror="this.style.display='none'"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
