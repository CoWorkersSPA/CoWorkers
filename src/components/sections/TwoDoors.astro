---
// src/components/sections/TwoDoors.astro
// Dos puertas, una empresa: los servicios de Coworkers.cl (el problema antes que la pieza,
// sin nombrar herramientas) y Mesón, la línea para la pyme que atiende en el mostrador.
import Button from "@components/ui/Button.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";

const services = [
    {
        icon: "ph-code",
        title: "Desarrollo a medida",
        description:
            "Cuando tu operación necesita algo que ningún sistema trae: un portal donde tus clientes vean su pedido, un módulo sobre tu sistema de gestión, un sitio con lógica propia.",
        tags: ["Plataformas internas", "Portales de cliente", "Sitios y landings"],
    },
    {
        icon: "ph-arrows-clockwise",
        title: "Automatizaciones",
        description:
            "Cobranza que recuerda sola, citas que se confirman, el reporte del lunes y documentos que se leen sin que nadie los transcriba. Corren en servidores propios: sin costo por ejecución.",
        tags: ["Cobranza", "Citas", "Reportes", "Lectura de documentos"],
    },
    {
        icon: "ph-hard-drives",
        title: "Infraestructura",
        description:
            "Correo con tu dominio, nube para tus archivos y una sola clave para todo. Va incluida en cada proyecto, no se vende por pieza. Lo que te ofrecemos es lo que usamos.",
        tags: ["Correo", "Nube", "Acceso único", "Dominio"],
    },
];

// TODO: cuando exista la página de Mesón (meson.coworkers.cl o /meson), volver a "Conocer Mesón" apuntando ahí.
// Mientras tanto el botón no puede ser un enlace muerto: pregunta por correo, con asunto propio.
const MESON_HREF = "mailto:hola@coworkers.cl?subject=Quiero%20saber%20m%C3%A1s%20de%20Mes%C3%B3n";
---

<section class="section" id="servicios">
    <div class="container">
        <Eyebrow text="Dos puertas, una empresa" class="reveal" />
        <h2 class="section-title reveal">Servicios para quien ya sabe qué necesita. Mesón para quien atiende en el mostrador.</h2>

        <div class="doors">
            <div class="services">
                {services.map((s, i) => (
                    <article class="service reveal" data-delay={i}>
                        <span class="icon-tile" aria-hidden="true"><i class={`ph ${s.icon}`}></i></span>
                        <div>
                            <h3>{s.title}</h3>
                            <p>{s.description}</p>
                            <div class="what">{s.tags.map((t) => <span>{t}</span>)}</div>
                        </div>
                    </article>
                ))}
            </div>

            <aside class="meson reveal" id="meson" data-delay="1" data-spotlight>
                <!-- TODO: reemplazar por foto propia de la tablet en un mostrador de Concepción. Hoy es una foto de archivo (Unsplash vía Picsum). -->
                <img
                    src="/img/meson-mostrador.jpg"
                    width="1000"
                    height="1200"
                    alt=""
                    loading="lazy"
                />
                <p class="kicker">Mesón, de Coworkers.cl</p>
                <h3>Tu negocio, <em>a la mano.</em></h3>
                <p>Una tablet en tu mostrador que te deja ordenado para la ley de datos, cobra a tiempo y cotiza sin llamar al proveedor. Se usa con el dedo. Sin manual.</p>
                <Button href={MESON_HREF} icon="ph-arrow-right">Preguntar por Mesón</Button>
            </aside>
        </div>
    </div>
</section>

<style>
    h2.section-title { max-width: 30ch; }
    .doors { display: grid; grid-template-columns: 7fr 5fr; gap: 48px; margin-top: 48px; align-items: stretch; }
    .services { display: flex; flex-direction: column; }

    /* Cada servicio es una fila que se enciende al pasar: fondo tintado, tile del ícono elevado. */
    .service {
        position: relative;
        display: grid; grid-template-columns: 52px 1fr; gap: 24px; align-items: start;
        padding: 30px 20px; margin-inline: -20px;
        border-top: 1px solid var(--divider);
        border-radius: var(--radius-lg);
        transition: background-color 0.4s var(--ease), transform 0.4s var(--ease);
    }
    .service:last-child { border-bottom: 1px solid var(--divider); }
    .service::before {
        content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
        background: radial-gradient(70% 100% at 0% 50%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
        opacity: 0; transition: opacity 0.4s var(--ease);
    }
    .service:hover { background: color-mix(in srgb, var(--surface) 50%, transparent); transform: translateX(4px); }
    .service:hover::before { opacity: 1; }
    .service:hover .icon-tile { transform: translateY(-2px); color: var(--a-200); box-shadow: var(--shadow-glow); }
    .service .icon-tile { margin-top: 2px; }
    .service h3 { font-size: 22px; margin-bottom: 8px; }
    .service p { color: var(--n-400); max-width: 54ch; }
    .what { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-top: 16px; font-size: 13px; }
    .what span {
        padding: 4px 10px; border-radius: 6px;
        color: var(--n-400);
        background: color-mix(in srgb, var(--n-500) 9%, transparent);
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--n-500) 16%, transparent);
        transition: color 0.3s var(--ease), background-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    }
    .service:hover .what span { color: var(--a-300); background: color-mix(in srgb, var(--accent) 10%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent); }

    /* Mesón: tarjeta con foto, borde que sigue al cursor y sombra tintada. */
    .meson {
        --mx: 50%; --my: 50%;
        position: relative; overflow: hidden; isolation: isolate;
        border-radius: var(--radius-lg);
        background: var(--a-900);
        box-shadow: var(--shadow-lg);
        display: flex; flex-direction: column; justify-content: flex-end;
        min-height: 520px;
        padding: 32px;
        transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
    }
    .meson:hover { transform: translateY(-4px); box-shadow: 0 30px 70px -28px var(--shadow-tint), 0 0 0 1px color-mix(in srgb, var(--coral) 32%, transparent); }
    .meson img {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.6;
        transition: transform 1.2s var(--ease), opacity 0.6s var(--ease);
    }
    .meson:hover img { transform: scale(1.04); opacity: 0.7; }
    .meson::before {
        /* foco de luz bajo el cursor */
        content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 1;
        background: radial-gradient(360px circle at var(--mx) var(--my), color-mix(in srgb, var(--coral) 10%, transparent), transparent 60%);
        opacity: 0; transition: opacity 0.5s var(--ease);
    }
    .meson:hover::before { opacity: 1; }
    .meson::after {
        content: ""; position: absolute; inset: 0;
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--a-900) 5%, transparent) 15%, var(--a-900) 78%),
            radial-gradient(70% 50% at 100% 0%, color-mix(in srgb, var(--coral) 12%, transparent), transparent 70%);
    }
    .meson :global(.edge) {
        /* borde luminoso que sigue al cursor */
        position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 2;
        padding: 1px;
        background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--coral-300) 70%, transparent), color-mix(in srgb, var(--coral) 22%, transparent) 40%, transparent 70%);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor; mask-composite: exclude;
        opacity: 0; transition: opacity 0.5s var(--ease);
    }
    .meson:hover :global(.edge) { opacity: 1; }
    .meson > :global(:not(img):not(.edge)) { position: relative; z-index: 1; } /* sobre el degradado, dentro del contexto aislado */
    .kicker { font-size: 14px; color: var(--coral-300); margin-bottom: 10px; }
    .meson h3 { font-size: 32px; line-height: 1.1; }
    .meson h3 em { font-style: italic; color: var(--coral-300); }
    .meson p:not(.kicker) { color: var(--a-200); margin-top: 12px; max-width: 40ch; }
    /* El botón de Mesón lleva el coral como tinta suave: sin borde, fondo al 14%, texto claro.
       Deja a "Agendar 30 min" como único botón de contorno con acento: la jerarquía se mantiene. */
    .meson :global(.btn) {
        margin-top: 24px; align-self: flex-start;
        border-color: transparent; color: var(--coral-200);
        background: color-mix(in srgb, var(--coral) 14%, transparent);
    }
    .meson :global(.btn:hover) {
        color: var(--coral-200); border-color: transparent;
        background: color-mix(in srgb, var(--coral) 24%, transparent);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--coral) 8%, transparent);
    }
    .meson :global(.btn:active) { background: color-mix(in srgb, var(--coral) 32%, transparent); }
    @media (max-width: 1023px) {
        .doors { grid-template-columns: 1fr; }
        .meson { min-height: 420px; }
        .service { padding-inline: 16px; margin-inline: -16px; }
    }
    @media (hover: none) { .service:hover { transform: none; } }
</style>

<script>
    // Spotlight: el borde y el foco siguen al puntero (pointermove, no scroll).
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
        const edge = document.createElement("span");
        edge.className = "edge";
        edge.setAttribute("aria-hidden", "true");
        card.appendChild(edge);
        if (reduce) return;
        card.addEventListener("pointermove", (e) => {
            const r = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${e.clientX - r.left}px`);
            card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
    });
</script>
