---
// src/components/sections/HowWeWork.astro
// Cuatro pasos sobre una sola línea (vertical en móvil). Sin numerales: el contenido es la etiqueta.
const steps = [
    {
        title: "Treinta minutos en tu local",
        description:
            "Vamos nosotros. Miramos cómo funciona hoy tu negocio: el cuaderno, el WhatsApp, lo que sea. Sales con el alcance por escrito, contrates o no.",
    },
    {
        title: "Lo cortamos en tareas chicas",
        description:
            "Cada una de pocas horas, con criterio de aceptación claro. Va al estudiante adecuado, que cobra al aceptarse la entrega. Tú no coordinas a nadie.",
    },
    {
        title: "Revisamos antes de integrar",
        description:
            "Ninguna tarea entra al proyecto sin pasar por uno de los cinco socios. El riesgo lo corremos nosotros, no tú.",
    },
    {
        title: "Instalamos y lo mantenemos encendido",
        description:
            "Lo dejamos funcionando en tu local. Una sola mensualidad cubre servidor, respaldo, mejoras y alguien con nombre a quien llamar.",
    },
];
---

<section class="section how" id="como-trabajamos">
    <div class="container">
        <hr class="rule" />
        <h2 class="section-title reveal">Cuatro pasos. Ningún manual.</h2>
        <div class="steps">
            {steps.map((s, i) => (
                <div class="step reveal" data-delay={i}>
                    <h3>{s.title}</h3>
                    <p>{s.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .how { padding-top: 0; }
    h2 { margin-top: 96px; max-width: 30ch; }
    .steps { margin-top: 56px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; position: relative; }
    .steps::before {
        content: ""; position: absolute; left: 0; right: 0; top: 7px; height: 1px;
        background: linear-gradient(90deg, transparent, var(--divider) 48px, var(--divider) calc(100% - 48px), transparent);
    }
    .step { position: relative; padding-top: 28px; }
    .step::before {
        content: ""; position: absolute; top: 0; left: 0; width: 15px; height: 15px; border-radius: 50%;
        background: var(--bg); border: 1px solid var(--accent);
    }
    .step h3 { font-size: 20px; margin-bottom: 10px; }
    .step p { color: var(--n-400); font-size: 16px; }
    @media (max-width: 1023px) {
        h2 { margin-top: 64px; }
        .steps { grid-template-columns: 1fr; gap: 0; padding-left: 28px; }
        .steps::before {
            left: 7px; right: auto; top: 0; bottom: 0; width: 1px; height: auto;
            background: linear-gradient(180deg, transparent, var(--divider) 24px, var(--divider) calc(100% - 24px), transparent);
        }
        .step { padding: 0 0 36px 0; }
        .step::before { left: -28px; top: 6px; }
    }
</style>
