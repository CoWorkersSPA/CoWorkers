---
// src/components/sections/HowWeWork.astro
import SectionSplit from "../ui/SectionSplit.astro";
import NumberedItem from "../ui/NumberedItem.astro";

const steps = [
    {
        number: "01",
        title: "Conversamos 30 minutos",
        description:
            "Nos cuentas cómo funciona hoy tu operación. Sales con un alcance escrito y un rango de plazo.",
    },
    {
        number: "02",
        title: "Lo cortamos en tareas chicas",
        description:
            "Cada una de pocas horas y con criterio de aceptación claro. Ese corte fino es lo que hace posible el modelo.",
    },
    {
        number: "03",
        title: "Se reparte dentro del equipo",
        description:
            "Cada tarea va al estudiante adecuado, que cobra por entrega. Eso pasa por dentro: tú no coordinas a nadie.",
    },
    {
        number: "04",
        title: "Revisamos y publicamos",
        description:
            "Nada se integra sin pasar por nuestra revisión. El riesgo lo corremos nosotros.",
    },
];
---

<SectionSplit heading="Cómo lo hacemos" id="como-lo-hacemos" class="bg-muted">
    <div class="space-y-8">
        {
            steps.map((step) => (
                <NumberedItem
                    number={step.number}
                    title={step.title}
                    description={step.description}
                />
            ))
        }
    </div>
</SectionSplit>
