---
// src/components/sections/Team.astro
// Historia de marca, versión "home o pitch" (estrategia, sección 02), sobre foto a sangre.
import { mailto } from "../../config";

const STUDENT_HREF = mailto("Quiero trabajar con Coworkers.cl");

const paragraphs = [
  "Empezó en una mesa de la Santa María. Cinco compañeros de Ingeniería en Informática, cada uno obsesionado con una cosa distinta: gestión, la máquina, el sistema, la seguridad, los datos. Cuando uno presentaba algo, los otros cuatro siempre encontraban algo. Eso era el equipo.",
  "También vimos quién faltaba: compañeros buenos que dejaban de venir porque tenían que trabajar. Fuera de Santiago, estudiar y pagar la carrera son cosas excluyentes. Nos pareció una regla estúpida. Así que no subcontratamos: formamos. Tareas acotadas, compatibles con el semestre, pagadas al aceptarse y revisadas entre los cinco.",
  "Estamos partiendo, y preferimos decirlo a inventar una lista de clientes. Lo que sí puedes pedirnos está más arriba, por escrito, en cada proyecto.",
];
---

<section class="team" id="equipo">
  {/* PROVISIONAL — foto de archivo (Unsplash vía Picsum): un paisaje que no dice nada de nosotros.
      No afirma nada falso, pero tampoco prueba nada, y va bajo un titular sobre decir las cosas de
      frente. Sostiene la composición hasta la sesión propia: los cinco socios sobre fondo oscuro.
      El día que exista, se reemplaza el archivo y se borra este comentario. */}
  <img
    class="lighten"
    src="/img/socios.jpg"
    width="1600"
    height="900"
    alt=""
    loading="lazy"
  />
  <div class="container">
    <h2 class="reveal">
      Nuestro equipo actúa con compromiso y transparencia.    </h2>
    <div class="story">
      {paragraphs.map((t, i) => (
        <p class="reveal" data-delay={i}>
          {t}
        </p>
      ))}
    </div>
    <p class="student reveal" data-delay="3">
      ¿Estudias en Concepción? Tareas reales, pagadas al aceptarse y compatibles
      con el semestre: <a href={STUDENT_HREF}>escríbenos</a>.
    </p>
  </div>
</section>

<style>
  .team {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 140px;
    /* Igual que la banda: los bordes se desvanecen con máscara en vez de pintar --bg encima, así
               el fondo de la página y su aurora se ven a través y la unión no tiene canto. Alcanza a la
               foto y al velo de legibilidad. 80px cabe en el padding también en móvil (96px).
               Abajo NO se desvanece: el cierre empieza con un corte duro a propósito. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 80px);
    mask-image: linear-gradient(180deg, transparent 0, #000 80px);
  }
  .team > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .team::before {
    /* baño de color sobre la foto: violeta arriba a la derecha, índigo abajo */
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        60% 70% at 85% 20%,
        color-mix(in srgb, var(--coral) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        50% 60% at 70% 100%,
        color-mix(in srgb, var(--section-ghost) 55%, transparent),
        transparent 70%
      );
    mix-blend-mode: screen;
  }
  /* Sobre claro el baño de color tiene que oscurecer, no aclarar. */
  :global(html[data-theme="light"]) .team::before {
    mix-blend-mode: multiply;
  }
  .team::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Solo el velo horizontal, para que el texto se lea sobre la foto. El desvanecido vertical
               lo hace ahora la máscara de .team. */
    background: linear-gradient(
      90deg,
      var(--bg) 0%,
      var(--bg) 28%,
      color-mix(in srgb, var(--bg) 88%, transparent) 60%,
      color-mix(in srgb, var(--bg) 40%, transparent) 100%
    );
  }
  .container {
    position: relative;
    z-index: 1;
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 42px);
    max-width: 20ch;
  }
  h2::after {
    content: "";
    display: block;
    width: 72px;
    height: 2px;
    margin-top: 22px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  .story {
    margin-top: 28px;
    max-width: 60ch;
    display: grid;
    gap: 18px;
    color: var(--n-300);
  }
  .story p:first-child::first-letter {
    color: var(--a-300);
  }
  .student {
    margin-top: 44px;
    max-width: 60ch;
    font-size: 15px;
    color: var(--n-400);
  }
  .student a {
    color: var(--a-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .student a:hover {
    color: var(--a-200);
  }
  @media (max-width: 767px) {
    .team {
      padding-block: 96px;
    }
    .team > img {
      opacity: 0.4;
    }
  }
</style>
