---
// src/components/sections/Team.astro
// Historia de marca, versión "home o pitch" (estrategia, sección 02), sobre foto a sangre.
import Button from "@components/ui/Button.astro";

const paragraphs = [
    "Empezó en una mesa de coworking de la Santa María. Cinco compañeros de Ingeniería en Informática, cada uno obsesionado con una cosa distinta: gestión, la máquina, el sistema, la seguridad, los datos. Cuando uno presentaba algo, los otros cuatro siempre encontraban algo. Eso era el equipo.",
    "También vimos quién faltaba: compañeros buenos que dejaban de venir porque tenían que trabajar. Fuera de Santiago, estudiar y pagar la carrera son cosas excluyentes. Nos pareció una regla estúpida. Así que no subcontratamos: formamos. Tareas acotadas, compatibles con el semestre, pagadas al aceptarse y revisadas entre los cinco.",
];
---

<section class="team" id="equipo">
    {/* TODO: reemplazar por foto propia de los cinco socios (fondo oscuro). Hoy es una foto de archivo (Unsplash vía Picsum). */}
    <img
        class="lighten"
        src="/img/socios.jpg"
        width="1600"
        height="900"
        alt=""
        loading="lazy"
    />
    <div class="container">
        <h2 class="reveal">Nuestro equipo son estudiantes, y eso lo decimos de frente.</h2>
        <div class="story">
            {paragraphs.map((t, i) => <p class="reveal" data-delay={i}>{t}</p>)}
        </div>
        {/* <div class="student reveal">
            <span>¿Estudias en Concepción? Tareas reales, pagadas al aceptarse, compatibles con el semestre.</span>
            <Button
                href="mailto:hola@coworkers.cl?subject=Quiero%20trabajar%20con%20Coworkers.cl"
                variant="ghost"
                icon="ph-arrow-right">Escríbenos</Button
            >
        </div> */}
    </div>
</section>

<style>
    .team { position: relative; overflow: hidden; isolation: isolate; padding-block: 140px; }
    .team > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
    .team::before {
        /* baño de color sobre la foto: violeta arriba a la derecha, índigo abajo */
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background:
            radial-gradient(60% 70% at 85% 20%, color-mix(in srgb, var(--coral) 22%, transparent), transparent 70%),
            radial-gradient(50% 60% at 70% 100%, color-mix(in srgb, var(--section-ghost) 55%, transparent), transparent 70%);
        mix-blend-mode: screen;
    }
    /* Sobre claro el baño de color tiene que oscurecer, no aclarar. */
    :global(html[data-theme="light"]) .team::before { mix-blend-mode: multiply; }
    .team::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background:
            linear-gradient(90deg, var(--bg) 0%, var(--bg) 28%, color-mix(in srgb, var(--bg) 88%, transparent) 60%, color-mix(in srgb, var(--bg) 40%, transparent) 100%),
            linear-gradient(180deg, var(--bg) 0%, transparent 18%, transparent 82%, var(--bg) 100%);
    }
    .container { position: relative; z-index: 1; }
    h2 { font-size: clamp(28px, 3.4vw, 42px); max-width: 20ch; }
    h2::after {
        content: ""; display: block; width: 72px; height: 2px; margin-top: 22px; border-radius: 2px;
        background: linear-gradient(90deg, var(--accent), transparent);
    }
    .story { margin-top: 28px; max-width: 60ch; display: grid; gap: 18px; color: var(--n-300); }
    .story p:first-child::first-letter { color: var(--a-300); }
    .student { margin-top: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; color: var(--n-400); }
    @media (max-width: 767px) { .team { padding-block: 96px; } .team > img { opacity: 0.4; } }
</style>
