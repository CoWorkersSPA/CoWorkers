---
// src/components/sections/Team.astro
const paragraphs = [
    "Nuestro equipo son estudiantes, y eso lo decimos de frente. No subcontratamos: formamos.",
    "Buscamos uno a uno a estudiantes universitarios de Concepción, les damos tareas acotadas compatibles con su semestre, les pagamos apenas se acepta la entrega y todo pasa por nuestra revisión.",
    "La falta de recursos es una de las principales causas de deserción universitaria, y fuera de la capital estas oportunidades escasean todavía más.",
    "Tú contratas software; de paso, tu presupuesto financia semestres que alguien termina.",
];
---

<section id="equipo" class="py-16 md:py-24 border-t border-border bg-muted">
    <div class="wrapper">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-center"
        >
            <!-- Columna Izquierda: Textos -->
            <div class="lg:col-span-6 space-y-6">
                <h2
                    class="font-display font-bold text-2xl md:text-3xl text-foreground"
                >
                    Quiénes lo escriben
                </h2>

                <div class="space-y-4">
                    {
                        paragraphs.map((text, index) => {
                            const isFirst = index === 0;
                            const isLast = index === paragraphs.length - 1;

                            return (
                                <p
                                    class:list={[
                                        "text-sm md:text-base leading-relaxed",
                                        isFirst
                                            ? "text-foreground font-medium"
                                            : "text-muted-foreground",
                                        isLast
                                            ? "text-foreground font-medium pt-2"
                                            : "",
                                    ]}
                                >
                                    {text}
                                </p>
                            );
                        })
                    }
                </div>
            </div>

            <!-- Columna Derecha: Foto -->
            <div class="lg:col-span-6">
                <div
                    class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-border bg-background flex items-center justify-center shadow-sm"
                    role="img"
                    aria-label="Foto del equipo trabajando"
                >
                    <img
                        src="/team-photo.jpg"
                        alt="Equipo trabajando"
                        class="w-full h-full object-cover"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <span class="absolute text-sm text-muted-foreground hidden">
                        Foto del equipo trabajando
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
