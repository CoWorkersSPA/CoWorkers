---
// src/components/sections/Team.astro
// Historia de marca, versión "home o pitch" (estrategia, sección 02).
const paragraphs = [
    "Nuestro equipo son estudiantes, y eso lo decimos de frente.",
    "Empezó en una mesa de coworking de la Santa María. Cinco compañeros de Ingeniería en Informática, cada uno obsesionado con una cosa distinta: gestión, la máquina, el sistema, la seguridad, los datos. Cuando uno presentaba algo, los otros cuatro siempre encontraban algo. Eso era el equipo.",
    "También vimos quién faltaba: compañeros buenos que dejaban de venir porque tenían que trabajar. Fuera de Santiago, estudiar y pagar la carrera son cosas excluyentes. Nos pareció una regla estúpida. Así que no subcontratamos: formamos. Tareas acotadas, compatibles con el semestre, pagadas al aceptarse y revisadas entre los cinco.",
    "Estamos partiendo: no tenemos casos que mostrarte y no vamos a inventarlos.",
];
---

<section
    id="equipo"
    class="section fade-on-scroll py-16 md:py-24 border-t border-border"
>
    <div class="wrapper">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-center"
        >
            <div class="lg:col-span-6 space-y-6">
                <h2
                    class="font-display font-bold text-2xl md:text-3xl text-foreground"
                >
                    Quiénes lo hacen
                </h2>

                <div class="space-y-4">
                    {
                        paragraphs.map((text, index) => {
                            const isFirst = index === 0;
                            const isLast = index === paragraphs.length - 1;

                            return (
                                <p
                                    class:list={[
                                        "text-sm md:text-base leading-relaxed",
                                        isFirst
                                            ? "text-foreground font-medium"
                                            : "text-muted-foreground",
                                        isLast
                                            ? "text-foreground font-medium pt-2"
                                            : "",
                                    ]}
                                >
                                    {text}
                                </p>
                            );
                        })
                    }
                </div>

                <p class="pt-4 border-t border-border text-sm md:text-base text-muted-foreground leading-relaxed">
                    ¿Estudias en Concepción? Tareas reales, pagadas al aceptarse,
                    compatibles con el semestre.
                    <a
                        href="mailto:hola@coworkers.cl?subject=Quiero%20trabajar%20con%20Coworkers.cl"
                        class="font-medium text-foreground hover:underline"
                    >
                        Escríbenos
                    </a>
                </p>
            </div>

            <!-- Columna Derecha: Foto -->
            <div class="lg:col-span-6">
                <div
                    class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-border bg-background flex items-center justify-center shadow-sm"
                    role="img"
                    aria-label="Foto de los socios de Coworkers.cl"
                >
                    <img
                        src="/team-photo.jpg"
                        alt="Los socios de Coworkers.cl en la mesa de coworking de la Universidad Santa María"
                        class="w-full h-full object-cover"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <span class="absolute text-sm text-muted-foreground hidden">
                        Foto del equipo trabajando
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
