---
// src/components/sections/WhatWeAreNot.astro
import SectionSplit from "../ui/SectionSplit.astro";

const negations = [
    "No somos una agencia con tres capas entre tú y el código.",
    "No hacemos apps móviles ni nada fuera del navegador. Solo web, bien hecha.",
    "No mandamos propuestas de cuarenta páginas para justificar el precio.",
    "No tenemos casos que mostrarte todavía: estamos partiendo, y no vamos a inventarlos.",
];
---

<SectionSplit heading="Lo que no somos" id="lo-que-no-somos">
    <ul class="space-y-4">
        {
            negations.map((item) => (
                <li class="flex items-start gap-3 text-muted-foreground text-base leading-relaxed">
                    <span
                        class="text-muted-foreground/60 select-none font-sans"
                        aria-hidden="true"
                    >
                        •
                    </span>
                    <span>{item}</span>
                </li>
            ))
        }
    </ul>
</SectionSplit>
