---
// src/components/sections/WhatWeAreNot.astro
import Eyebrow from "../ui/Eyebrow.astro";

const negations = [
    "No somos una agencia con tres capas entre tú y el código.",
    "No mandamos propuestas de cuarenta páginas para justificar el precio.",
    "No hacemos apps móviles ni nada fuera del navegador. Solo web, bien hecha.",
    "No tenemos casos que mostrarte todavía: estamos partiendo, y no vamos a inventarlos.",
];
---

<section class="what-we-are-not section--tight">
    <div class="wrapper">
        <div class="section-head">
            <Eyebrow text="Lo que no somos" />
        </div>

        <ul class="what-we-are-not__list">
            {
                negations.map((item) => (
                    <li>
                        <span aria-hidden="true">—</span>
                        <span>{item}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .what-we-are-not__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-sm) var(--space-xl);
    }

    .what-we-are-not__list li {
        display: flex;
        gap: 0.75rem;
        font-size: 0.9375rem;
        color: var(--color-muted-foreground);
        line-height: 1.6;
    }

    .what-we-are-not__list li span:first-child {
        color: var(--color-muted-foreground);
        opacity: 0.7;
        flex-shrink: 0;
    }

    @media (max-width: 700px) {
        .what-we-are-not__list {
            grid-template-columns: 1fr;
        }
    }
</style>
