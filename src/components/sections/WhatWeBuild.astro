---
// src/components/sections/WhatWeBuild.astro
import SectionSplit from "../ui/SectionSplit.astro";
import FeatureCard from "../ui/FeatureCard.astro";

// Orden pensado para una grilla de 2 columnas leída por fila
// (antes: Plataformas, Portales / Productos, Sitios).
const features = [
    {
        title: "Plataformas internas",
        description:
            "Gestión, inventario, agenda y reportería, con usuarios y permisos.",
    },
    {
        title: "Productos en tiempo real",
        description: "Tableros vivos, chat y notificaciones con WebSockets.",
    },
    {
        title: "Portales de cliente",
        description: "Cotización, seguimiento de pedidos, documentos y pagos.",
    },
    {
        title: "Sitios con lógica propia",
        description:
            "Reservas, formularios serios e integraciones con lo que ya usas.",
    },
];
---

<section class="section fade-on-scroll what-we-build" id="que-construimos">
    <div class="wrapper">
        <SectionSplit heading="Qué construimos">
            <div class="what-we-build__grid">
                {
                    features.map((f) => (
                        <FeatureCard
                            title={f.title}
                            description={f.description}
                        />
                    ))
                }
            </div>

            <p class="what-we-build__note">
                Si vive en el navegador, lo hacemos
            </p>
        </SectionSplit>
    </div>
</section>

<style>
    .what-we-build__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-lg) var(--space-xl);
        margin-bottom: var(--space-xl);
    }

    .what-we-build__note {
        font-size: 0.9375rem;
        font-style: italic;
        color: var(--color-muted-foreground);
        margin: 0;
        padding-top: var(--space-md);
        border-top: 1px solid var(--color-border);
    }

    @media (max-width: 700px) {
        .what-we-build__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
