---
// src/components/sections/PainQuotes.astro
import SectionSplit from "../ui/SectionSplit.astro";
import QuoteCard from "../ui/QuoteCard.astro";

const quotes = [
    "El archivo bueno es el que tiene Marcela.",
    "Cerrar el mes nos toma tres días de copiar y pegar.",
    "Los pedidos entran por WhatsApp y a veces se pierden.",
    "El cliente llama para preguntar en qué va lo suyo.",
];
---

<SectionSplit
    id="nos-llaman-cuando"
    heading="Nos llaman cuando..."
    class="pain-quotes"
>
    <div class="pain-quotes__list space-y-6">
        {quotes.map((quote) => <QuoteCard quote={quote} />)}
    </div>
</SectionSplit>
