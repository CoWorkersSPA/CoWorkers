---
// src/components/sections/Hero.astro
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="py-16 md:py-24 fade-on-scroll">
    <div class="wrapper">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
            <div class="lg:col-span-7 max-w-xl space-y-6">
                <Eyebrow text="DESARROLLO WEB · CONCEPCIÓN, CHILE" />

                <h1
                    class="font-display font-bold text-5xl md:text-6xl text-foreground tracking-tight leading-[1.08]"
                >
                    Tu proyecto paga la carrera de alguien.
                </h1>

                <p
                    class="text-muted-foreground text-base md:text-lg leading-relaxed"
                >
                    Construimos tu aplicación web y repartimos el trabajo, por
                    dentro, entre estudiantes universitarios que formamos y
                    pagamos por entrega. Tú tratas con nosotros: un contrato, un
                    interlocutor, un responsable.
                </p>

                <div class="pt-2">
                    <Button href="#agendar" variant="solid">
                        Agendar 30 minutos
                    </Button>
                </div>
            </div>

            <!-- Columna Derecha: Texto secundario de fundadores -->
            <div class="lg:col-span-5 pb-2 lg:pl-4">
                <p
                    class="text-xs md:text-sm text-muted-foreground leading-relaxed max-w-xs"
                >
                    Sin costo y sin compromiso. Estamos partiendo: los primeros
                    proyectos van con precio y atención de fundador.
                </p>
            </div>
        </div>
    </div>
</section>
