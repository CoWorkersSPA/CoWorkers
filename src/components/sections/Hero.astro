---
// src/components/sections/Hero.astro
// Hero tipográfico: la promesa rotativa "Tu proyecto…" es el visual. No lleva foto a propósito:
// una imagen de archivo aquí es una prueba falsa (docs/MENSAJES.md, sección 07). Cuando exista una
// foto propia (tablet en un mostrador de Concepción), vuelve el hero partido: columna derecha con
// .frame + .halo, ver historial de este archivo.
import Button from "@components/ui/Button.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";

// Sistema rotativo (estrategia de marca, sección 03: mantener el mecanismo). El sujeto es el
// negocio del cliente, no el modelo de la empresa: la frase rota sobre resultados que la pyme
// quiere, así cualquiera de las cinco que alcance a leer es una promesa y no una petición.
// El modelo estudiantil baja al apoyo, donde explica por qué cuesta menos en vez de pedir un favor.
const phrases = [
  "cobrando a tiempo.",
  "en regla con la ley de datos.",
  "con el inventario al día.",
  "sin depender del cuaderno.",
  "atendida sin hacer esperar.",
];
const ROTATION_MS = 3200;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
    <span class="mesh"></span>
    <span class="ring"></span>
  </div>
  <div class="container">
    <Eyebrow text="Software para pymes. Concepción, Chile." class="reveal in" />
    {/* Sin aria-live: la rotación es decorativa y anunciarla cada 3,2 s deja la página
        inusable con lector de pantalla. El apoyo de abajo lleva el mensaje completo. */}
    <h1 class="reveal in">
      Tu pyme,{" "}
      <span class="rot text-glow" data-hero-phrase>
        {phrases[0]}
      </span>
    </h1>
    <div class="hero-foot reveal in" data-delay="1">
      <p class="lead">
        Software que se entiende el primer día, instalado en tu local por gente
        de Concepción. Lo construye un equipo universitario al que formamos,
        revisamos y pagamos por cada entrega.
      </p>
      <div class="ctas">
        <Button href="#agendar" icon="ph-arrow-right">
          Agendar 30 min
        </Button>
        <Button href="#servicios" variant="ghost">
          Ver qué resolvemos
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 96px 0 120px;
    overflow: hidden;
    isolation: isolate;
    min-height: calc(100dvh - var(--nav-h));
    display: flex;
    align-items: center;
  }

  /* Fondo: dos orbes de luz (violeta e índigo), una malla de puntos que se desvanece y un anillo fino
     a la derecha, donde antes iba la foto. La luz ocupa el espacio; el texto no lo necesita. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Sin filter: blur. Un degradado radial de varias paradas ya da la caída suave, y desenfocar
     una superficie de 800px a dos veces la densidad es de lo más caro que puede pedir la página. */
  .orb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }
  .orb-a {
    width: 52vw;
    height: 52vw;
    max-width: 820px;
    max-height: 820px;
    /* Alineado al borde del hero, no fuera: con closest-side el degradado llega a alfa 0 justo
               en el borde del elemento, así overflow: hidden no corta nada con color. */
    right: -14vw;
    top: 0;
    /* closest-side: el degradado llega a transparente justo en el borde del elemento. Con
               farthest-corner todavía quedaba color ahí y el border-radius lo cortaba en seco. */
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--coral) 24%, transparent) 0%,
      color-mix(in srgb, var(--coral) 13%, transparent) 40%,
      color-mix(in srgb, var(--coral) 4%, transparent) 68%,
      transparent 100%
    );
  }
  .orb-b {
    width: 40vw;
    height: 40vw;
    max-width: 620px;
    max-height: 620px;
    left: -14vw;
    bottom: 0;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--section-ghost) 60%, transparent) 0%,
      color-mix(in srgb, var(--section-ghost) 30%, transparent) 40%,
      color-mix(in srgb, var(--section-ghost) 10%, transparent) 68%,
      transparent 100%
    );
  }
  .mesh {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--a-300) 22%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(
      60% 70% at 72% 45%,
      #000 0%,
      transparent 100%
    );
    mask-image: radial-gradient(60% 70% at 72% 45%, #000 0%, transparent 100%);
    opacity: 0.6;
  }
  .ring {
    position: absolute;
    right: -6vw;
    top: 50%;
    translate: 0 -50%;
    width: 44vw;
    height: 44vw;
    max-width: 700px;
    max-height: 700px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--coral) 22%, transparent);
    -webkit-mask-image: linear-gradient(250deg, #000 20%, transparent 70%);
    mask-image: linear-gradient(250deg, #000 20%, transparent 70%);
  }
  .ring::before {
    content: "";
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--coral) 12%, transparent);
  }

  h1 {
    font-size: clamp(40px, 5.2vw, 74px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 26ch; /* la frase más larga (38 caracteres con "Tu pyme,") cabe en dos líneas */
    min-height: 2.08em; /* reserva 2 líneas: la frase rota sin mover el resto */
    text-wrap: initial; /* balance rompe la reserva de líneas con la frase rotativa */
  }
  .rot {
    display: inline;
    padding-right: 0.06em;
  } /* inline: la frase puede partir de línea junto con el titular */

  /* Pie del hero: apoyo a la izquierda, botones a la derecha, sobre la misma línea base. */
  .hero-foot {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 52ch) auto;
    gap: 24px 64px;
    align-items: end;
  }
  .lead {
    font-size: 19px;
    color: var(--n-400);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 1279px) {
    .hero-foot {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 1023px) {
    .hero {
      padding: 56px 0 80px;
      min-height: 0;
      display: block;
    }
    .hero-foot {
      margin-top: 32px;
    }
  }
  @media (max-width: 767px) {
    h1 {
      min-height: 3.12em;
    } /* en móvil la frase más larga ocupa tres líneas */
    .ring {
      display: none;
    }
    .orb-a {
      right: -30vw;
      top: 0;
      width: 90vw;
      height: 90vw;
    } /* top: 0 por lo mismo que en escritorio */
  }
  @media (prefers-reduced-motion: no-preference) {
    .rot {
      animation: rot-in 0.6s var(--ease) both;
    }
    @keyframes rot-in {
      from {
        opacity: 0;
        filter: blur(8px);
      }
      to {
        opacity: 1;
        filter: none;
      }
    }
    .orb-a {
      animation: orb-a 18s ease-in-out infinite alternate;
    }
    .orb-b {
      animation: orb-b 22s ease-in-out infinite alternate;
    }
    @keyframes orb-a {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(-6%, 8%, 0) scale(1.08);
      }
    }
    @keyframes orb-b {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(8%, -6%, 0) scale(1.1);
      }
    }
    .ring {
      animation: ring-spin 90s linear infinite;
    }
    @keyframes ring-spin {
      to {
        rotate: 360deg;
      }
    }
  }
</style>

<script is:inline define:vars={{ phrases, ROTATION_MS }}>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let el = document.querySelector("[data-hero-phrase]");
    if (!el) return;
    let i = 0;
    setInterval(() => {
      i = (i + 1) % phrases.length;
      const next = el.cloneNode(false); // nodo nuevo = la animación de entrada vuelve a correr
      next.textContent = phrases[i];
      el.replaceWith(next);
      el = next;
    }, ROTATION_MS);
  })();
</script>
