---
// src/components/sections/Hero.astro
import Button from "@components/ui/Button.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";

// Sistema rotativo "Tu proyecto…" (estrategia de marca, sección 03: mantener).
const phrases = [
    "paga la carrera de alguien.",
    "le da experiencia real a un estudiante.",
    "mantiene a alguien en la universidad.",
    "contrata talento de regiones.",
    "cuesta menos de lo que te dijeron.",
];
const ROTATION_MS = 3200;
---

<section class="hero">
    <div class="container hero-grid">
        <div>
            <Eyebrow text="Software para pymes. Concepción, Chile." class="reveal in" />
            <h1 class="reveal in" aria-live="polite">
                Tu proyecto <span class="rot" data-hero-phrase>{phrases[0]}</span>
            </h1>
            <p class="lead reveal in" data-delay="1">
                Resolvemos un problema concreto de tu pyme, cobrar, cumplir,
                ordenar, con software que se entiende y es tuyo.
            </p>
            <div class="ctas reveal in" data-delay="2">
                <Button href="#agendar" icon="ph-arrow-right">Agendar 30 min</Button>
                <Button href="#meson" variant="ghost">Conocer Mesón</Button>
            </div>
        </div>
        <div class="hero-visual reveal in" data-delay="2">
            <!-- TODO: reemplazar por foto propia del equipo (fondo oscuro, pantallas encendidas). Hoy es una foto de archivo (Unsplash vía Picsum). -->
            <img
                class="lighten"
                src="/img/equipo.jpg"
                width="1200"
                height="1500"
                alt=""
                fetchpriority="high"
            />
        </div>
    </div>
</section>

<style>
    .hero { position: relative; padding: 80px 0 96px; overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 56px; align-items: center; }
    h1 {
        font-size: clamp(36px, 3.7vw, 50px);
        line-height: 1.08;
        letter-spacing: -0.032em;
        max-width: 28ch;
        min-height: 2.16em; /* reserva 2 líneas: la frase rota sin mover el resto */
    }
    .rot { color: var(--a-300); } /* inline: la frase puede partir de línea junto con el titular */
    .lead { margin-top: 26px; max-width: 52ch; font-size: 19px; color: var(--n-400); }
    .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
    .hero-visual { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; }
    .hero-visual::before {
        content: ""; position: absolute; inset: -30%; pointer-events: none;
        background: radial-gradient(60% 50% at 70% 30%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%);
    }
    .hero-visual img { width: 100%; height: 100%; object-fit: cover; }
    .hero-visual::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(180deg, transparent 55%, var(--bg) 100%), linear-gradient(90deg, var(--bg) 0%, transparent 25%);
    }
    @media (max-width: 1023px) {
        .hero { padding: 56px 0 72px; }
        .hero-grid { grid-template-columns: 1fr; gap: 40px; }
        .hero-visual { aspect-ratio: 16 / 10; order: 2; }
    }
    @media (prefers-reduced-motion: no-preference) {
        .rot { animation: rot-in 0.55s var(--ease) both; }
        @keyframes rot-in { from { opacity: 0; } to { opacity: 1; } }
    }
</style>

<script is:inline define:vars={{ phrases, ROTATION_MS }}>
    (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        let el = document.querySelector("[data-hero-phrase]");
        if (!el) return;
        let i = 0;
        setInterval(() => {
            i = (i + 1) % phrases.length;
            const next = el.cloneNode(false); // nodo nuevo = la animación de entrada vuelve a correr
            next.textContent = phrases[i];
            el.replaceWith(next);
            el = next;
        }, ROTATION_MS);
    })();
</script>
