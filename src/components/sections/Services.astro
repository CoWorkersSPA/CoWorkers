---
// src/components/sections/Services.astro
// Las tres líneas de Coworkers.cl (arquitectura de marca, sección 04),
// con el problema antes que la pieza. Ninguna herramienta nombrada.
import SectionSplit from "@components/ui/SectionSplit.astro";
import FeatureCard from "@components/ui/FeatureCard.astro";

const services = [
    {
        title: "Desarrollo a medida",
        description:
            "Cuando tu operación necesita algo que ningún sistema trae: un portal donde tus clientes vean su pedido, un módulo sobre tu sistema de gestión, un sitio con lógica propia.",
    },
    {
        title: "Automatizaciones",
        description:
            "Cobranza que recuerda sola, citas que se confirman, el reporte del lunes y documentos que se leen sin que nadie los transcriba. Corren en servidores propios: sin costo por ejecución.",
    },
    {
        title: "Infraestructura",
        description:
            "Correo con tu dominio, nube para tus archivos y una sola clave para todo. Va incluida en cada proyecto, no se vende por pieza. Lo que te ofrecemos es lo que usamos.",
    },
];
---

<SectionSplit
    heading="Servicios para quien ya sabe qué necesita"
    id="servicios"
    class="section fade-on-scroll"
>
    <div class="services__list">
        {
            services.map((s) => (
                <FeatureCard title={s.title} description={s.description} />
            ))
        }
    </div>
</SectionSplit>

<style>
    .services__list {
        display: grid;
        grid-template-columns: 1fr;
    }
    .services__list > :global(.feature-card) {
        margin-top: 0;
        padding-block: 1.75rem;
        border-top: 1px solid var(--color-border);
    }
    .services__list > :global(.feature-card:last-child) {
        border-bottom: 1px solid var(--color-border);
    }
    .services__list > :global(.feature-card) :global(.feature-card__desc) {
        max-width: 55ch;
    }
</style>
