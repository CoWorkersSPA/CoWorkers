---
// src/components/sections/ValueProps.astro
import SectionSplit from "../ui/SectionSplit.astro";
import NumberedItem from "../ui/NumberedItem.astro";

const items = [
    {
        number: "01",
        title: "Una sola fuente de verdad",
        description:
            "Con usuarios, permisos e historial de quién cambió qué y cuándo. Se acabó el archivo bueno que vive en un computador.",
    },
    {
        number: "02",
        title: "Tus clientes se atienden solos",
        description:
            "Cotizan, siguen su pedido y descargan documentos sin llamar a nadie. Tu equipo vuelve a lo que sí cobra.",
    },
    {
        number: "03",
        title: "El cierre de mes deja de ser un evento",
        description:
            "Los reportes salen del sistema, no de armar planillas a mano el último viernes.",
    },
];
---

<SectionSplit heading="Lo que te queda" id="lo-que-te-queda" class="bg-muted">
    <div class="space-y-8">
        {
            items.map((item) => (
                <NumberedItem
                    number={item.number}
                    title={item.title}
                    description={item.description}
                />
            ))
        }
    </div>

    <div class="pt-8 border-t border-border mt-8">
        <p class="text-xs md:text-sm italic text-muted-foreground">
            Primer entregable usable en unas tres semanas: algo que puedas abrir
            y usar, no una maqueta.
        </p>
    </div>
</SectionSplit>
