---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Coworkers — Desarrollo web en Concepción, Chile",
	description = "Construimos tu aplicación web y repartimos el trabajo, por dentro, entre estudiantes universitarios que formamos y pagamos por entrega.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>
