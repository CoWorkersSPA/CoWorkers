---
// src/layouts/Layout.astro
import "@styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Coworkers — Desarrollo web en Concepción, Chile",
	description = "Construimos tu aplicación web y repartimos el trabajo, por dentro, entre estudiantes universitarios que formamos y pagamos por entrega.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Script anti-FOUC (Evita destello blanco antes de cargar el CSS) -->
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				const systemDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				if (savedTheme === "dark" || (!savedTheme && systemDark)) {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			})();
		</script>
	</head>

	<body>
		<slot />
		<script>
			const sections = document.querySelectorAll(".fade-on-scroll");

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						entry.target.classList.toggle(
							"is-visible",
							entry.isIntersecting,
						);
					});
				},
				{
					threshold: 0.15, // se activa cuando ~15% de la sección es visible
					rootMargin: "0px 0px -10% 0px",
				},
			);

			sections.forEach((section) => observer.observe(section));
		</script>
	</body>
</html>
