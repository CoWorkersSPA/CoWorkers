---
// src/layouts/Layout.astro
import "@styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Coworkers.cl · Software que se entiende",
	description = "Resolvemos un problema concreto de tu pyme, cobrar, cumplir, ordenar, con software que se entiende y es tuyo. Construido en Concepción por un equipo universitario que formamos, revisamos y pagamos por entrega.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Datos estructurados: quién es la empresa, para buscadores y asistentes de IA.
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://coworkers.cl/#organization",
	name: "Coworkers.cl",
	legalName: "Coworkers SpA",
	url: "https://coworkers.cl",
	logo: "https://coworkers.cl/favicon-512.png",
	slogan: "Software que se entiende.",
	description:
		"Empresa de software para pymes en Concepción, Chile. Resuelve un problema concreto del negocio (cobrar, cumplir con la ley de datos, ordenar) con software que se entiende y es del cliente, construido y revisado por un equipo universitario.",
	email: "hola@coworkers.cl",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Concepción",
		addressRegion: "Región del Biobío",
		addressCountry: "CL",
	},
	areaServed: ["Concepción", "Talcahuano", "San Pedro de la Paz", "Chiguayante", "Hualpén", "Chile"],
	knowsLanguage: "es-CL",
	brand: [
		{ "@type": "Brand", name: "Coworkers.cl" },
		{ "@type": "Brand", name: "Mesón, de Coworkers.cl", slogan: "Tu negocio, a la mano." },
	],
	makesOffer: [
		{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Desarrollo a medida", description: "Portales de cliente, módulos sobre el sistema de gestión y sitios con lógica propia." } },
		{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Automatizaciones", description: "Cobranza automática, confirmación de citas, reportes y lectura de documentos." } },
		{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Mesón Datos", description: "Auditoría y cumplimiento de la Ley 21.719 de datos personales." } },
		{ "@type": "Offer", itemOffered: { "@type": "Service", name: "Mesón Cobros", description: "Cobranza automática por WhatsApp y correo desde una tablet en el mostrador." } },
	],
};
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#161826" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:site_name" content="Coworkers.cl" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen para asistentes de IA" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Producción: auto-hospedar Inter con @font-face + font-display: swap. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<!-- Íconos: Phosphor (el set que fija Nocturne). -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
		/>
	</head>

	<body>
		<slot />
		<script>
			// Scroll-reveal con IntersectionObserver (nunca listeners de scroll).
			const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
			const els = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
			if (reduce || !("IntersectionObserver" in window)) {
				els.forEach((el) => el.classList.add("in"));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add("in");
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
				);
				els.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
